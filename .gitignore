# зависимости и сборка Next.js (папка app/)
node_modules/
app/.next/
app/out/
app/next-env.d.ts
app/tsconfig.tsbuildinfo

# промежуточный HTML сборки PDF: из него печатается лист, хранить нечего
app/.pdf-build/

# готовые файлы с ответами. Репозиторий публичный, поэтому таким файлам
# здесь не место: они собираются в CI и уезжают архивом со страницы
# запуска. Куда что ложится, решает app/src/lib/sheet/outputs.js
app/pdf-private/

# исходники сторонних авторов (задачники, тренажёры, конспекты) в
# репозиторий не кладутся: в content-source/ и docs/sources/ остаются
# только наши описания — соответствие прототипам, наблюдения, исключаемые
# наборы чисел. Проверка: app/scripts/check-repo-files.mjs
content-source/**/*.pdf
docs/sources/**

# системное
.DS_Store
*.log

# Python
__pycache__/

# Чужие авторские материалы (задачники) в публичном репозитории не хранятся.
content-source/**/*.pdf
