# Вход в облегчённый набор на сервере. Повторяет то, что у Supabase
# делает шлюз (Kong, теперь Envoy), ровно в том объёме, который нужен
# supabase-js:
#
#   /auth/v1/*  → GoTrue,    /rest/v1/* → PostgREST;
#   заголовок apikey обязателен и должен быть ключом anon или
#   service_role, иначе 401 — как у Supabase;
#   без apikey открыты только адреса из писем (/auth/v1/verify,
#   /otpiska и /roditel), по ним человек переходит из почты обычной ссылкой,
#   и Result URL Robokassa (/oplata/result) — его подпись проверяет сервис;
#   CORS — только для адресов сайта.
#
# Сертификат Caddy получает и продлевает сам (Let's Encrypt), как только
# A-запись api.budetege.ru смотрит на сервер. Ключи и адреса берутся из
# окружения контейнера ({$…}), см. compose.yml.

{
	admin off
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
	{$CADDY_EXTRA_GLOBAL}
}

(cors) {
	@site {
		header Origin {$SITE_ORIGIN}
		header Origin {$SITE_ORIGIN_2}
	}
	header @site {
		Access-Control-Allow-Origin "{http.request.header.Origin}"
		Access-Control-Allow-Credentials "true"
		Access-Control-Expose-Headers "Content-Range, Content-Location, X-Supabase-Api-Version"
		Vary Origin
	}
	# Предварительный запрос браузера (OPTIONS) не несёт apikey,
	# поэтому отвечаем на него до проверки ключа.
	@preflight {
		method OPTIONS
		header Origin {$SITE_ORIGIN}
		header Origin {$SITE_ORIGIN_2}
	}
	handle @preflight {
		header {
			Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
			Access-Control-Allow-Headers "Authorization, Apikey, Content-Type, Accept, Accept-Profile, Content-Profile, Prefer, Range, X-Client-Info, X-Supabase-Api-Version, X-Retry-Count"
			Access-Control-Max-Age "3600"
		}
		respond 204
	}
	@foreign method OPTIONS
	handle @foreign {
		respond 403
	}
}

(no_key) {
	header Content-Type application/json
	respond `{"message":"Invalid API key","hint":"Double check your Supabase anon or service_role API key."}` 401
}

{$API_DOMAIN} {
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# Журнал запросов — без одноразовых токенов из писем (token в
	# /auth/v1/verify, t в /roditel) и подписи «Отписаться» (t в /otpiska): путь, время
	# и код ответа для разбора сбоев остаются.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
					delete t
				}
			}
		}
	}

	import cors

	# Для «Проверить здоровье»: сам Caddy жив.
	handle /health {
		respond "ok" 200
	}

	# Ссылки из писем: подтверждение почты и сброс пароля. Ключа в них
	# нет, токен одноразовый и проверяется самим GoTrue.
	handle_path /auth/v1/verify* {
		rewrite * /verify{path}
		reverse_proxy auth:9999 {
			# Адреса в письмах GoTrue строит из API_EXTERNAL_URL, а не из
			# заголовков запроса.
			header_up -X-Forwarded-Host
			header_down -Access-Control-Allow-Origin
		}
	}

	# «Отписаться» из писем уведомлений (RFC 8058): ключа в ссылке нет,
	# подпись проверяет база; отвечает рассыльщик (compose.yml, notifier).
	handle /otpiska* {
		reverse_proxy notifier:8090 {
			header_down -Access-Control-Allow-Origin
		}
	}

	# Согласие родителя из письма: ключа в ссылке нет, одноразовый токен
	# проверяет база (confirm_parent_consent); отвечает рассыльщик.
	handle /roditel* {
		reverse_proxy notifier:8090 {
			header_down -Access-Control-Allow-Origin
		}
	}

	# Уведомление Robokassa об оплате (Result URL): ключа нет, подпись
	# Паролем №2 проверяет сервис оплаты (compose.yml, oplata).
	handle /oplata/result {
		reverse_proxy oplata:8091 {
			header_down -Access-Control-Allow-Origin
		}
	}

	# Ссылка на оплату — с сайта: ключ anon и вход человека, как у /rest/v1.
	handle /oplata/sozdat {
		@bad_key not {
			header apikey {$ANON_KEY}
			header apikey {$SERVICE_ROLE_KEY}
		}
		handle @bad_key {
			import no_key
		}
		reverse_proxy oplata:8091 {
			header_down -Access-Control-Allow-Origin
		}
	}

	handle_path /auth/v1/* {
		@bad_key not {
			header apikey {$ANON_KEY}
			header apikey {$SERVICE_ROLE_KEY}
		}
		handle @bad_key {
			import no_key
		}
		reverse_proxy auth:9999 {
			header_up -X-Forwarded-Host
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Expose-Headers
		}
	}

	handle_path /rest/v1/* {
		@bad_key not {
			header apikey {$ANON_KEY}
			header apikey {$SERVICE_ROLE_KEY}
		}
		handle @bad_key {
			import no_key
		}
		reverse_proxy rest:3000 {
			header_down -Access-Control-Allow-Origin
			header_down -Access-Control-Allow-Credentials
			header_down -Access-Control-Expose-Headers
		}
	}

	handle {
		respond 404
	}
}

# Шаблоны писем для GoTrue. Порт не опубликован: виден только внутри
# сети контейнеров.
:8081 {
	root * /srv/templates
	file_server
}

# Проверка контейнера (healthcheck в compose.yml), тоже только внутри.
:8082 {
	respond /health "ok" 200
}
