  RewriteRule ^zadaniya/18((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya-dokazatelstvo$1/ [R=301,L]
  RewriteRule ^zadaniya/18/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya-dokazatelstvo/$1 [R=301,L]
  RewriteRule ^zadaniya/19((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/parametr$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/19((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/parametr$1/ [R=301,L]
  RewriteRule ^zadaniya/19/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/parametr/$1 [R=301,L]
  RewriteRule ^zadaniya/20((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/chisla$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/20((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/chisla$1/ [R=301,L]
  RewriteRule ^zadaniya/20/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/chisla/$1 [R=301,L]
  RewriteRule ^zadaniya/21((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/naibolshee-naimenshee$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/21((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/naibolshee-naimenshee$1/ [R=301,L]
  RewriteRule ^zadaniya/21/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/naibolshee-naimenshee/$1 [R=301,L]
  # PDF в материалах: папка и имя — по коду раздела, без номера.
  RewriteRule ^materials/zadanie-1/spravochnik-po-planimetrii-bez-primerov\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/planimetriya/spravochnik-po-planimetrii-bez-primerov.pdf [R=301,L]
  RewriteRule ^materials/zadanie-1/spravochnik-po-planimetrii\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/planimetriya/spravochnik-po-planimetrii.pdf [R=301,L]
  RewriteRule ^materials/zadanie-4/Zadanie_4_baza_uchenik\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/veroyatnost/teoriya-veroyatnostey-baza-uchenik.pdf [R=301,L]
  RewriteRule ^materials/zadanie-4/zadanie-4-teoriya-veroyatnostey-uchenik-chb\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/veroyatnost/teoriya-veroyatnostey-uchenik-chb.pdf [R=301,L]
