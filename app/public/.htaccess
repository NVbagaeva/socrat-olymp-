# Заголовки кеширования статического экспорта.
#
# Страницы у нас с постоянными адресами: /zadaniya/12/linear/trenazher/
# всегда один и тот же файл, а содержимое меняется при каждом
# обновлении сайта. Сервер отдаёт их без Cache-Control, и браузер
# решает сам, сколько держать копию, — ученик видел вчерашнюю
# страницу и не понимал, почему ничего не поменялось.
#
# Поэтому страницы просим перепроверять всегда: ответ 304 стоит
# одного лёгкого запроса, а не мегабайта разметки. Файлы сборки
# трогать незачем: их имена собраны по содержимому, и сервер уже
# держит их год.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Service worker push (docs/kabinet-uvedomleniya.md, PR 3г) и manifest:
# имя постоянное, поэтому тоже перепроверять всегда — иначе исправление
# в sw.js доходило бы до браузеров через сутки.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
AddType application/manifest+json .webmanifest

# ── Заголовки защиты ────────────────────────────────────────────────
#
# Браузеру: страницы сайта нельзя вставлять в рамку на чужом сайте
# (свои страницы в рамке — можно, ими пользуется /dev/intro/), тип файла
# не угадывать, адрес страницы чужим сайтам — только домен, ненужные
# устройства (камера, микрофон, геопозиция) выключены, сайт открывать
# только по https. CSP — только правила, которые не трогают скрипты
# Next.js: рамки, <base>, плагины, адреса отправки форм. Полную CSP
# со скриптами включают отдельной правкой, сначала в режиме Report-Only.
# Проверка — scripts/check-security-headers.mjs (pnpm test:headers,
# с --url — на живом сайте).

<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # По http браузер этот заголовок не принимает — проверкам на localhost он не мешает.
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# ── Служебные файлы: посетителю — 403 ───────────────────────────────
#
# Файлы с точкой в начале имени (.htaccess, .ftp-deploy-sync-state.json —
# список залитых файлов действия выкладки) посетителю не отдаются.

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ── Скрытые разделы: посетителю — 404 ───────────────────────────────
#
# Раздел, которого нет в действующей структуре экзамена
# (src/content/struktura.js, vne), с сайта не удаляется: его страницы
# собираются как обычно, но посетителю любой его адрес отвечает 404 —
# не редиректом. Администратор открывает раздел из кабинета: кнопка
# «Открыть» ставит cookie budetege_skrytye=1, с ней сервер отдаёт
# страницы (src/lib/skrytye.ts). Поисковикам — X-Robots-Tag: noindex.
#
# Правила стоят первыми: раньше косой черты и переехавших страниц,
# иначе адрес скрытого раздела ответил бы 301.
#
# Сами правила пишет сборка — scripts/build-skrytye.mjs после
# next build вставляет их в out/.htaccess между строками-метками.
# Руками между метками ничего не пишут: в этом файле там пусто.
# Проверка — scripts/check-skrytye.mjs (pnpm test:skrytye).
#
# >>> skrytye-razdely
# <<< skrytye-razdely

# ── Косая черта на конце адреса — сразу с https ─────────────────────
#
# Каждая страница — папка с index.html: настоящий адрес /zadaniya/, а не
# /zadaniya. На адрес без косой черты Apache сам (DirectorySlash) отвечает
# 301 на http://…/zadaniya/ — с понижением до http: он стоит за nginx и не
# знает, что запрос пришёл по https. Chrome это проглатывает, а Safari
# при переходе внутри сайта блокирует такой редирект, и ученик видит
# белый экран.
#
# Ссылки на сайте все с косой чертой (lib/paths.ts, проверка
# scripts/check-trailing-slash.mjs). Это — страховка для старых ссылок
# из закладок и поисковиков: косую черту добавляем сами, одним
# редиректом и сразу на https.
#
# Options -Indexes обязательно: при DirectorySlash Off Apache иначе мог
# бы показать список файлов папки.
#
# Схема в адресе перенаправления — https. Исключение — сервер на
# localhost/127.0.0.1: так Apache поднимают проверки в CI (без https).
# Правило ^ - [E=…] адрес не меняет, только запоминает схему.

Options -Indexes

# Своя страница «Такой страницы нет» (src/app/ne-naydeno/page.tsx). Путь
# локальный, а не полный адрес: с полным адресом Apache ответил бы
# редиректом вместо кода 404.
ErrorDocument 404 /ne-naydeno/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ - [E=SITE_SCHEME:https]
  RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$
  RewriteRule ^ - [E=SITE_SCHEME:http]
</IfModule>

# ── Переехавшие страницы: сразу 301 на новый адрес ──────────────────
#
# По старым адресам в сборке лежат страницы-заглушки
# (components/layout/Redirect.tsx), но до них браузер не доходит:
# сервер отвечает 301 раньше, и ученик не видит промежуточной страницы.
# ?… сохраняется сам, #… браузер переносит сам. Правила ловят адрес
# с косой чертой и без, с index.html и без; служебные index.txt не
# трогаем — переход внутри сайта уводит RedirectNow.tsx.
#
# Новый перенос страницы = новая строка здесь + заглушка в сборке +
# обновлённые внутренние ссылки (CLAUDE.md, scripts/check-links.mjs).

<IfModule mod_rewrite.c>
  # Задание №3: прежние разделы по фигурам.
  RewriteRule ^zadaniya/(?:3|stereometriya)/(parallelepiped|prizma|piramida|konus|cilindr|shar|vpisannyy-cilindr|vpisannaya-sfera)/(podgotovka|opornye-zadachi)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/opornye-zadachi/ [R=301,L]
  RewriteRule ^zadaniya/(?:3|stereometriya)/(parallelepiped|prizma|piramida|konus|cilindr|shar|vpisannyy-cilindr|vpisannaya-sfera)/trenazher(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/trenazher/ [R=301,L]
  RewriteRule ^zadaniya/(?:3|stereometriya)/(parallelepiped|prizma|piramida)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/teoriya/#teoriya-mnogogranniki [R=301,L,NE]
  RewriteRule ^zadaniya/(?:3|stereometriya)/(konus|cilindr|shar)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/teoriya/#teoriya-vrashcheniya [R=301,L,NE]
  RewriteRule ^zadaniya/(?:3|stereometriya)/(vpisannyy-cilindr|vpisannaya-sfera)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/teoriya/#teoriya-kombinacii [R=301,L,NE]
  # Задание №3: разбор типа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/(?:3|stereometriya)/razbor/([a-z0-9-]+)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/#tip-$1 [R=301,L,NE]
  # Задание №1: разбор группы типов раскрывается на вкладке «О задании»
  # (карточка группы и её первый тип).
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/ugly-treugolnika(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-I [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/chetyrehugolniki(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-II [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/ploshchad(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-III [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/podobie(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-IV [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/trigonometriya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-V [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/ugly-okruzhnosti(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-VI [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/vpisannaya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-VII [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/opisannaya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-VIII [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/sinusy(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-IX [R=301,L,NE]
  RewriteRule ^zadaniya/(?:1|planimetriya)/razbor/dopolnitelnye(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/#gruppa-X [R=301,L,NE]
  # Задание №7: разбор прототипа раскрывается на вкладке «О задании»;
  # вкладки «Для репетиторов» нет — листы собирает «Генератор».
  RewriteRule ^zadaniya/(?:7|uravneniya)/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravneniya/#tip-$1 [R=301,L,NE]
  # Задание №6: разбор прототипа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/(?:6|sluchainye-velichiny)/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/sluchainye-velichiny/#tip-$1 [R=301,L,NE]
  # Задание №12: пустые «Тетрадь» и «Ошибки» вида функции — на тренажёр вида.
  RewriteRule ^zadaniya/(?:12|grafiki-funkciy)/(linear|quadratic|rational|irrational|exponential|logarithmic|trigonometric)/(tetrad|oshibki)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/grafiki-funkciy/$1/trenazher/ [R=301,L]
  # Задание №10: разбор прототипа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/(?:10|prikladnye-zadachi)/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/prikladnye-zadachi/#tip-$1 [R=301,L,NE]
  RewriteRule ^zadaniya/(?:7|uravneniya)/dlya-repetitorov(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravneniya/generator/ [R=301,L]
  # Задание №18: «О задании» стало главной страницей раздела.
  RewriteRule ^zadaniya/(?:18|planimetriya-dokazatelstvo)/o-zadanii(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya-dokazatelstvo/ [R=301,L]
  # >>> pereezd-kody
  # Адреса банка по номеру хранения → по коду раздела (scripts/build-pereezd.mjs).
  # Блок пишет скрипт, руками не править.
  RewriteRule ^zadaniya/1((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/1((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya$1/ [R=301,L]
  RewriteRule ^zadaniya/1/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/planimetriya/$1 [R=301,L]
  RewriteRule ^zadaniya/2((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vektory$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/2((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vektory$1/ [R=301,L]
  RewriteRule ^zadaniya/2/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vektory/$1 [R=301,L]
  RewriteRule ^zadaniya/3((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/3((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya$1/ [R=301,L]
  RewriteRule ^zadaniya/3/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya/$1 [R=301,L]
  RewriteRule ^zadaniya/4((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/veroyatnost$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/4((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/veroyatnost$1/ [R=301,L]
  RewriteRule ^zadaniya/4/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/veroyatnost/$1 [R=301,L]
  RewriteRule ^zadaniya/5((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/slozhnaya-veroyatnost$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/5((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/slozhnaya-veroyatnost$1/ [R=301,L]
  RewriteRule ^zadaniya/5/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/slozhnaya-veroyatnost/$1 [R=301,L]
  RewriteRule ^zadaniya/7((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravneniya$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/7((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravneniya$1/ [R=301,L]
  RewriteRule ^zadaniya/7/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravneniya/$1 [R=301,L]
  RewriteRule ^zadaniya/8((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vychisleniya$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/8((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vychisleniya$1/ [R=301,L]
  RewriteRule ^zadaniya/8/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/vychisleniya/$1 [R=301,L]
  RewriteRule ^zadaniya/9((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/proizvodnaya$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/9((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/proizvodnaya$1/ [R=301,L]
  RewriteRule ^zadaniya/9/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/proizvodnaya/$1 [R=301,L]
  RewriteRule ^zadaniya/10((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/prikladnye-zadachi$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/10((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/prikladnye-zadachi$1/ [R=301,L]
  RewriteRule ^zadaniya/10/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/prikladnye-zadachi/$1 [R=301,L]
  RewriteRule ^zadaniya/11((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/tekstovye-zadachi$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/11((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/tekstovye-zadachi$1/ [R=301,L]
  RewriteRule ^zadaniya/11/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/tekstovye-zadachi/$1 [R=301,L]
  RewriteRule ^zadaniya/12((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/grafiki-funkciy$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/12((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/grafiki-funkciy$1/ [R=301,L]
  RewriteRule ^zadaniya/12/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/grafiki-funkciy/$1 [R=301,L]
  RewriteRule ^zadaniya/13((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/ekonomika$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/13((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/ekonomika$1/ [R=301,L]
  RewriteRule ^zadaniya/13/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/ekonomika/$1 [R=301,L]
  RewriteRule ^zadaniya/14((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravnenie-s-otborom$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/14((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravnenie-s-otborom$1/ [R=301,L]
  RewriteRule ^zadaniya/14/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/uravnenie-s-otborom/$1 [R=301,L]
  RewriteRule ^zadaniya/15((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya-dokazatelstvo$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/15((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya-dokazatelstvo$1/ [R=301,L]
  RewriteRule ^zadaniya/15/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/stereometriya-dokazatelstvo/$1 [R=301,L]
  RewriteRule ^zadaniya/16((?:/[^/.]+)*)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/neravenstvo$1/opornye-zadachi$2/ [R=301,L]
  RewriteRule ^zadaniya/16((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/neravenstvo$1/ [R=301,L]
  RewriteRule ^zadaniya/16/(.+\.[A-Za-z0-9]+)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/neravenstvo/$1 [R=301,L]
  RewriteRule ^zadaniya/17((?:/[^/.]+)*)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/ekonomika/optimizaciya/ [R=301,L]
