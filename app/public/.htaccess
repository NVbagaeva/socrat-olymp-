  RewriteRule ^materials/zadanie-12/obrazec-cvet\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/grafiki-funkciy/obrazec-cvet.pdf [R=301,L]
  RewriteRule ^materials/zadanie-12/zadanie-12-lineynaya-funkciya-uchenik-chb\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/grafiki-funkciy/lineynaya-funkciya-uchenik-chb.pdf [R=301,L]
