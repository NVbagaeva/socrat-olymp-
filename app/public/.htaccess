  RewriteRule ^materials/zadanie-9/zadanie-9-proizvodnaya-uchenik-chb\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/proizvodnaya/proizvodnaya-uchenik-chb.pdf [R=301,L]
