# Заголовки кеширования статического экспорта.
#
# Страницы у нас с постоянными адресами: /zadaniya/12/linear/trenazher/
# всегда один и тот же файл, а содержимое меняется при каждом
# обновлении сайта. Сервер отдаёт их без Cache-Control, и браузер
# решает сам, сколько держать копию, — ученик видел вчерашнюю
# страницу и не понимал, почему ничего не поменялось.
#
# Поэтому страницы просим перепроверять всегда: ответ 304 стоит
# одного лёгкого запроса, а не мегабайта разметки. Файлы сборки
# трогать незачем: их имена собраны по содержимому, и сервер уже
# держит их год.

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Косая черта на конце адреса — сразу с https ─────────────────────
#
# Каждая страница — папка с index.html: настоящий адрес /zadaniya/, а не
# /zadaniya. На адрес без косой черты Apache сам (DirectorySlash) отвечает
# 301 на http://…/zadaniya/ — с понижением до http: он стоит за nginx и не
# знает, что запрос пришёл по https. Chrome это проглатывает, а Safari
# при переходе внутри сайта блокирует такой редирект, и ученик видит
# белый экран.
#
# Ссылки на сайте все с косой чертой (lib/paths.ts, проверка
# scripts/check-trailing-slash.mjs). Это — страховка для старых ссылок
# из закладок и поисковиков: косую черту добавляем сами, одним
# редиректом и сразу на https.
#
# Options -Indexes обязательно: при DirectorySlash Off Apache иначе мог
# бы показать список файлов папки.
#
# Схема в адресе перенаправления — https. Исключение — сервер на
# localhost/127.0.0.1: так Apache поднимают проверки в CI (без https).
# Правило ^ - [E=…] адрес не меняет, только запоминает схему.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ - [E=SITE_SCHEME:https]
  RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$
  RewriteRule ^ - [E=SITE_SCHEME:http]
</IfModule>

# ── Переехавшие страницы: сразу 301 на новый адрес ──────────────────
#
# По старым адресам в сборке лежат страницы-заглушки
# (components/layout/Redirect.tsx), но до них браузер не доходит:
# сервер отвечает 301 раньше, и ученик не видит промежуточной страницы.
# ?… сохраняется сам, #… браузер переносит сам. Правила ловят адрес
# с косой чертой и без, с index.html и без; служебные index.txt не
# трогаем — переход внутри сайта уводит RedirectNow.tsx.
#
# Новый перенос страницы = новая строка здесь + заглушка в сборке +
# обновлённые внутренние ссылки (CLAUDE.md, scripts/check-links.mjs).

<IfModule mod_rewrite.c>
  # Задание №3: прежние разделы по фигурам.
  RewriteRule ^zadaniya/3/(parallelepiped|prizma|piramida|konus|cilindr|shar|vpisannyy-cilindr|vpisannaya-sfera)/(podgotovka|opornye-zadachi)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/opornye-zadachi/ [R=301,L]
  RewriteRule ^zadaniya/3/(parallelepiped|prizma|piramida|konus|cilindr|shar|vpisannyy-cilindr|vpisannaya-sfera)/trenazher(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/trenazher/ [R=301,L]
  RewriteRule ^zadaniya/3/(parallelepiped|prizma|piramida)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/teoriya/#teoriya-mnogogranniki [R=301,L,NE]
  RewriteRule ^zadaniya/3/(konus|cilindr|shar)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/teoriya/#teoriya-vrashcheniya [R=301,L,NE]
  RewriteRule ^zadaniya/3/(vpisannyy-cilindr|vpisannaya-sfera)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/teoriya/#teoriya-kombinacii [R=301,L,NE]
  # Задание №3: разбор типа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/3/razbor/([a-z0-9-]+)(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/3/#tip-$1 [R=301,L,NE]
  # Задание №1: разбор группы типов раскрывается на вкладке «О задании»
  # (карточка группы и её первый тип).
  RewriteRule ^zadaniya/1/razbor/ugly-treugolnika(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-I [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/chetyrehugolniki(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-II [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/ploshchad(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-III [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/podobie(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-IV [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/trigonometriya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-V [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/ugly-okruzhnosti(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-VI [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/vpisannaya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-VII [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/opisannaya(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-VIII [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/sinusy(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-IX [R=301,L,NE]
  RewriteRule ^zadaniya/1/razbor/dopolnitelnye(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/1/#gruppa-X [R=301,L,NE]
  # Задание №7: разбор прототипа раскрывается на вкладке «О задании»;
  # вкладки «Для репетиторов» нет — листы собирает «Генератор».
  RewriteRule ^zadaniya/7/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/7/#tip-$1 [R=301,L,NE]
  # Задание №6: разбор прототипа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/6/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/6/#tip-$1 [R=301,L,NE]
  # Задание №10: разбор прототипа раскрывается на вкладке «О задании».
  RewriteRule ^zadaniya/10/razbor/(P[0-9][0-9])(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/10/#tip-$1 [R=301,L,NE]
  RewriteRule ^zadaniya/7/dlya-repetitorov(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/7/generator/ [R=301,L]
  # Задание №18: «О задании» стало главной страницей раздела.
  RewriteRule ^zadaniya/18/o-zadanii(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/18/ [R=301,L]
  # «Подготовительные задачи» → «Опорные задачи» (content/opornye.ts):
  # …/podgotovka/ и …/podgotovka/{блок}/ у заданий и подтем.
  RewriteRule ^zadaniya/(.+)/podgotovka(/[^/.]+)?(/|/index\.html)?$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/zadaniya/$1/opornye-zadachi$2/ [R=301,L]
</IfModule>

# Без mod_rewrite DirectorySlash не выключаем: пусть лучше редирект
# Apache, чем папка без страницы.
<IfModule mod_rewrite.c>
  <IfModule mod_dir.c>
    DirectorySlash Off
  </IfModule>
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

# ── Служебные ответы роутера: …/index.txt ───────────────────────────
#
# При переходе по сайту Next.js не грузит страницу целиком, а берёт
# рядом с ней служебный файл index.txt (RSC) и дорисовывает экран.
# Это данные для сценария сайта, а не страница: открытый в браузере
# как документ, он показывает сырой текст «1:"$Sreact.fragment"…».
#
# 1. Открыли index.txt как страницу — уводим на саму страницу.
#    Страницу браузер запрашивает с Sec-Fetch-Dest: document; у старых
#    Safari этого заголовка нет, тогда признак — text/html в Accept.
#    Сценарий сайта шлёт Accept: */* и Sec-Fetch-Dest: empty, его
#    правило не трогает. Адрес — абсолютный, со схемой SITE_SCHEME
#    (см. выше): относительный Apache дописал бы через http.
# 2. Ответ не хранится ни браузером, ни промежуточным кешем: адрес
#    …/index.txt?_rsc=… не зависит от версии сборки.
# 3. Ответ зависит от Accept и Sec-Fetch-Dest — это сказано в Vary.
#
# Внимание: на хостинге .txt может отдавать сам nginx, минуя Apache и
# этот файл (см. docs/DEPLOYMENT.md). Тогда правила здесь не действуют, а
# от сырого текста защищает исправление в Next.js (patches/).

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Браузер говорит прямо: это переход на страницу.
  RewriteCond %{HTTP:Sec-Fetch-Dest} =document
  RewriteRule ^(.*/)?index\.txt$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/$1 [R=302,L,QSD]
  # Старый Safari без Sec-Fetch-Dest: страницу он просит с text/html.
  RewriteCond %{HTTP:Sec-Fetch-Dest} ^$
  RewriteCond %{HTTP_ACCEPT} text/html
  RewriteRule ^(.*/)?index\.txt$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/$1 [R=302,L,QSD]
</IfModule>

# Тип ответа — родной для RSC: Next.js его принимает (проверено
# scripts/check-rsc-serving.mjs), а браузер не показывает его как
# обычный текст.
<Files "index.txt">
  ForceType text/x-component
</Files>

<IfModule mod_headers.c>
  <Files "index.txt">
    Header always set Cache-Control "no-store"
    Header always set Vary "Accept, Sec-Fetch-Dest"
    Header always set X-Robots-Tag "noindex"
  </Files>
</IfModule>
