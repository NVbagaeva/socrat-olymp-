  RewriteRule ^materials/zadanie-5/zadanie-5-veroyatnosti-sobytiy-uchenik\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/slozhnaya-veroyatnost/veroyatnosti-sobytiy-uchenik.pdf [R=301,L]
  RewriteRule ^materials/zadanie-8/zadanie-8-vychisleniya-uchenik-chb\.pdf$ %{ENV:SITE_SCHEME}://%{HTTP_HOST}/materials/vychisleniya/vychisleniya-uchenik-chb.pdf [R=301,L]
